# Compose configuration. Copy to .env and adjust before deploying.
APP_PORT=3000
# Keep loopback for a reverse proxy on the same server.
# Use 0.0.0.0 explicitly if you want direct LAN access.
BIND_ADDRESS=127.0.0.1
# Optional canonical public origin, baked into the build. No trailing slash.
# Set before building on your server, e.g. https://classroom.example.org
APP_ORIGIN=
IMAGE_TAG=local
